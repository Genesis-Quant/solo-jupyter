{
  "FileContentsManager": {
    "always_delete_dir": true,
    "allow_hidden": true,
    "hide_globs": [
      "__pycache__",
      "*.pyc",
      "*.pyo",
      ".DS_Store",
      "*~",
      ".ipynb_checkpoints",
      ".git",
      "venv",
      ".pytest_cache",
      ".mypy_cache",
      "*.egg-info"
    ]
  },
  "ResourceUseDisplay": {
    "track_cpu_percent": true,
    "enable_prometheus_metrics": false
  }
}
