{
    // JupyterLab Shell
    // @jupyterlab/application-extension:shell
    // JupyterLab Shell 布局设置。
    // ***************************************

    // 自定义 shell 小部件定位
    // 覆盖应用程序布局中的默认小部件位置，例如，在多文档模式下将终端放置在右侧边栏中，在单个文档模式下则放置在底部区域，{
    //   "single": { "Terminal": { "area": "down" } },
    //   "multiple": { "Terminal": { "area": "right" } }
    // }。
    "layout": {
        "single": {
            "Linked Console": {
                "area": "down"
            },
            "Inspector": {
                "area": "down"
            },
            "Cloned Output": {
                "area": "down"
            },
            "dolphindb-document-workspace": {
                "area": "right",
                "options": {
                    "rank": 600
                }
            }
        },
        "multiple": {
            "dolphindb-document-workspace": {
                "area": "right",
                "options": {
                    "rank": 600
                }
            }
        }
    }
}