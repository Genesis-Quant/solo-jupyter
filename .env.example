# Copy to .env and replace these values before starting standalone Jupyter.
JUPYTER_TOKEN=replace-with-a-long-random-token
# Reuse the original unlock password when an encrypted keyring already exists.
JUPYTER_KEYRING_PASSWORD=replace-with-a-long-random-password

# Optional existing external Docker network; unset or empty lets Compose create its default network.
# The local DolphinDB container must join the selected network for container DNS access.
SOLO_DOCKER_NETWORK=

# Required for the cached stock_basic stock list (listed, delisted and suspended).
TUSHARE_TOKEN=

# Solo queries and factor analysis use the local DolphinDB.
# Fill in the actual username and password; both are required.
SOLO_DOLPHIN_HOST=dolphindb
SOLO_DOLPHIN_PORT=8848
SOLO_DOLPHIN_USERNAME=
SOLO_DOLPHIN_PASSWORD=

# Backtest uses the remote DolphinDB; actual credentials are required.
BACKTEST_DOLPHIN_HOST=210.45.79.253
BACKTEST_DOLPHIN_PORT=18902
BACKTEST_DOLPHIN_USERNAME=
BACKTEST_DOLPHIN_PASSWORD=
